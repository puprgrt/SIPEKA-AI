# =================================================================
# SIPEKA AI - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Sistem Informasi Penilaian Kerusakan Bangunan Gedung (DPUPR Garut)
# =================================================================

# -----------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
VITE_APP_NAME="SIPEKA - Sistem Informasi Penilaian Kerusakan Bangunan"
VITE_APP_URL="http://localhost:3000"
VITE_API_BASE_URL="http://localhost:3000/api"

# -----------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Supabase / Drizzle)
# -----------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sipeka_db?sslmode=disable"
SQL_HOST=localhost
SQL_PORT=5432
SQL_DB_NAME=sipeka_db
SQL_USER=postgres
SQL_PASSWORD=postgres
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=postgres

# -----------------------------------------------------------------
# 3. SUPABASE CLOUD / SELF-HOSTED CONFIGURATION
# -----------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# -----------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION
# -----------------------------------------------------------------
# Required for automated damage inspection & AI report generation
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"
VITE_GEMINI_MODEL="gemini-2.5-flash"

# -----------------------------------------------------------------
# 5. Tanda Tangan Elektronik (TTE) & QR Verification (BSRE / DPUPR)
# -----------------------------------------------------------------
TTE_API_URL="https://tte.garutkab.go.id/api/v1"
TTE_API_KEY="your-tte-api-key"
TTE_SECRET_KEY="your-tte-secret-key"
TTE_PASSPHRASE_SALT="your-passphrase-salt"
VITE_QR_VERIFY_URL="http://localhost:3000/verify"

# -----------------------------------------------------------------
# 6. GEOSPATIAL & MAP SERVICES (GIS / Leaflet / Nominatim)
# -----------------------------------------------------------------
VITE_MAP_TILE_PROVIDER="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
VITE_NOMINATIM_REVERSE_GEO_URL="https://nominatim.openstreetmap.org/reverse"
VITE_MAPBOX_TOKEN=""

# -----------------------------------------------------------------
# 7. FIREBASE AUTHENTICATION & STORAGE (OPTIONAL)
# -----------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
